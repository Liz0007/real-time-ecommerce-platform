KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# "local" writes JSONL to LOCAL_DATA_DIR (no AWS account needed).
# "s3" writes to S3 (or LocalStack via S3_ENDPOINT_URL).
SINK_MODE=local
LOCAL_DATA_DIR=/data/lake

S3_BUCKET=ecommerce-platform-data-lake
S3_ENDPOINT_URL=
AWS_REGION=us-east-1

# Used only by scripts/load_analytics_db.py
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/analytics