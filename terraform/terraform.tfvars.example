# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored,
# since it tends to accumulate account-specific values.

aws_region   = "eu-south-2"
environment  = "demo"
project_name = "ecommerce"
# GitHub repository allowed to deploy via OIDC (owner/name).
github_repo = "your-github-user/real-time-ecommerce-platform"
